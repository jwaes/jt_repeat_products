<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="product_attribute_view_form_inherit_product" model="ir.ui.view">
  <field name="model">product.attribute</field>
  <field name="inherit_id" ref="product.product_attribute_view_form"/>
  <field name="arch" type="xml">
   <field name="html_color" position="after">
    <field column_invisible="parent.display_type != 'color'" name="color_type"/>
    <field column_invisible="parent.display_type != 'color'" name="css_style" readonly="color_type != 'css'"/>
    <field class="oe_avatar" column_invisible="parent.display_type != 'color'" name="pattern_image" readonly="color_type != 'pattern'" widget="image"/></field></field>
 </record>
</odoo>